{
  "_doc": "Single source of truth for script-writer thresholds and banned content. Loaded by scripts/script_writer.py. Research basis: hook = swipe-through signal; specificity density = retention; loop = replay rate; opinion words = perceived authority.",

  "hook": {
    "min_words": 4,
    "max_words": 8,
    "hard_max_words": 10,
    "forbidden_openers": [
      "did you know",
      "have you ever",
      "a reddit user",
      "someone",
      "a person",
      "let me",
      "imagine",
      "picture this",
      "what if",
      "in this video",
      "today i",
      "i want to",
      "i'm going to"
    ]
  },

  "body": {
    "min_words": 80,
    "max_words": 130,
    "min_avg_sentence_words": 6,
    "max_avg_sentence_words": 14,
    "specificity_per_25_words": 1.0
  },

  "loop": {
    "must_share_token_with_hook": true,
    "min_shared_content_tokens": 1
  },

  "opinion_pool": [
    "worst", "wrong", "smartest", "scared", "dumbest",
    "never", "always", "richest", "poorest", "ruined",
    "broken", "fake", "real", "obvious", "rigged",
    "best", "secret", "lie", "truth", "dead",
    "alive", "won", "lost", "saved", "fixed",
    "destroyed", "beat", "crushed", "ignored", "afraid"
  ],

  "hedging_words": [
    "maybe", "perhaps", "could be", "might be", "kind of",
    "sort of", "i think", "possibly", "probably", "somewhat"
  ],

  "banned_phrases": [
    "buckle up", "let's dive in", "let me tell you", "imagine this", "picture this",
    "here's the thing", "here's why", "the truth is", "let's talk about",
    "in this video", "in today's video", "in today's world",
    "did you know", "have you ever", "what if i told you",
    "most people don't know", "nobody talks about", "the secret is",
    "one simple trick", "this changes everything",
    "game-changer", "game changer", "unlock", "skyrocket", "leverage",
    "dive deep", "delve", "revolutionize", "groundbreaking", "cutting-edge",
    "seamlessly", "robust", "empower", "synergy", "hustle harder",
    "it's important to note", "at the end of the day", "paradigm", "disrupt",
    "journey", "navigating", "landscape", "crucial", "vital", "actionable",
    "in many ways", "in some sense", "you could argue",
    "first and foremost", "moreover", "furthermore", "in conclusion",
    "to sum up", "all in all", "having said that",
    "remember", "always remember", "never forget"
  ],

  "scoring": {
    "score_min": 8,
    "hook_score_min": 7,
    "max_body_attempts": 3,
    "body_temperatures": [0.7, 0.95, 1.1],
    "hook_candidates": 8,
    "hook_temperature": 1.0,
    "hook_retry_temperature": 1.2,
    "min_surviving_hooks": 2
  },

  "models": {
    "hook_gen":   "gpt-4o-mini",
    "hook_score": "gpt-4o-mini",
    "body_gen":   "gpt-4o",
    "body_score": "gpt-4o",
    "pre_analyze": "gpt-4o-mini",
    "hook_gen_escalation": "gpt-4o"
  },

  "stopwords": [
    "the","a","an","is","are","was","were","be","been","being","am",
    "and","or","but","if","then","so","because","as","of","at","by",
    "for","with","about","against","between","into","through","during",
    "before","after","above","below","to","from","up","down","in","out",
    "on","off","over","under","again","further","once","here","there",
    "when","where","why","how","all","any","both","each","few","more","most",
    "other","some","such","no","nor","not","only","own","same","than","too",
    "very","can","will","just","should","would","could","may","might","must",
    "this","that","these","those","my","your","his","her","its","our","their",
    "i","me","you","he","she","it","we","they","them","him","us",
    "do","does","did","done","have","has","had","having"
  ]
}
