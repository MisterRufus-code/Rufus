# ── Free stock footage (get keys at links below, no credit card) ─────────
# Pexels free key:  https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Pixabay free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key_here

# ── YouTube Data API v3 (free) ────────────────────────────────────────────
# Download client_secrets.json from https://console.cloud.google.com/
# Enable "YouTube Data API v3" → OAuth 2.0 credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
DEFAULT_VIDEO_CATEGORY=22
DEFAULT_VIDEO_PRIVACY=private

# ── Qdrant vector DB (free, local Docker) ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rufus_media

# ── Media & output paths ─────────────────────────────────────────────────
MEDIA_LIBRARY_PATH=media_library
OUTPUT_PATH=output
FEEDBACK_DB_PATH=feedback.json

# ── Entropy threshold (0.0–1.0) ──────────────────────────────────────────
ENTROPY_MIN_SCORE=0.55

# ── Ollama runs locally, no key needed ───────────────────────────────────
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Pull model: ollama pull mistral
