# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
DEFAULT_VIDEO_CATEGORY=22
DEFAULT_VIDEO_PRIVACY=private

# Qdrant vector database (default: local Docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rufus_media

# Media & output paths
MEDIA_LIBRARY_PATH=media_library
OUTPUT_PATH=output
FEEDBACK_DB_PATH=feedback.json

# Entropy threshold (0.0–1.0, higher = stricter freshness requirement)
ENTROPY_MIN_SCORE=0.55
